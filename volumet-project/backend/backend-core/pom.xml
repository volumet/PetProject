<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>volumet.project</groupId>
		<artifactId>volumet-backend</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>volumet-backend-core</artifactId>
	<name>volumet-backend-core</name>
	<description>Project backend core services</description>

	<dependencies>
		<dependency>
			<groupId>volumet.project</groupId>
			<artifactId>volumet-backend-domain</artifactId>
		</dependency>

		<dependency>
			<groupId>volumet.project</groupId>
			<artifactId>volumet-common-mappers</artifactId>
		</dependency>

		<!-- Security dependencies -->
		<dependency>
			<groupId>volumet.project</groupId>
			<artifactId>volumet-security</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
			<scope>compile</scope>
		</dependency>

		<!-- Standard JPA dependencies for business layer -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Query dsl dependencies:
			JPA: use for jpa query
			APT: for Query Projection
		-->
		<dependency>
			<groupId>io.github.openfeign.querydsl</groupId>
			<artifactId>querydsl-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>io.github.openfeign.querydsl</groupId>
			<artifactId>querydsl-apt</artifactId>
			<classifier>jakarta</classifier>
			<scope>provided</scope>
		</dependency>

		<!-- Shared resilience stack: resilience4j, request coalescer, distributed lock, stampede guard -->
		<dependency>
			<groupId>volumet.project</groupId>
			<artifactId>volumet-common-resilience</artifactId>
		</dependency>

		<!-- Opt in to common-resilience's Redis distributed lock + cache stampede guard -->
		<dependency>
			<groupId>org.springframework.integration</groupId>
			<artifactId>spring-integration-redis</artifactId>
		</dependency>
	</dependencies>

	<!--
		Since the core layer combine lombok and mapstruct,
		it has to define the processors for all the plugins.
		Maven processor autoconfiguration will be disabled
		with annotationProcessorPaths.
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>

						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>${lombokbinding.version}</version>
						</path>

						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>

						<path>
							<groupId>io.github.openfeign.querydsl</groupId>
							<artifactId>querydsl-apt</artifactId>
							<classifier>jakarta</classifier>
							<version>${openfeign-querydsl.version}</version>
						</path>

						<!-- needed by the OpenFeign querydsl-apt processor -->
						<path>
							<groupId>jakarta.inject</groupId>
							<artifactId>jakarta.inject-api</artifactId>
							<version>${jakarta-inject.version}</version>
						</path>

						<path>
							<groupId>jakarta.persistence</groupId>
							<artifactId>jakarta.persistence-api</artifactId>
							<version>${jakarta-persistence.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
