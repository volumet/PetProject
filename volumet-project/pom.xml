<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <packaging>pom</packaging>
    <modules>
        <module>common</module>
        <module>security</module>
        <module>backend</module>
        <module>playground</module>
    </modules>

    <groupId>volumet.project</groupId>
    <artifactId>volumet-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <description>Personal project</description>

    <properties>
        <java.version>22</java.version>
        <springdoc.version>2.8.17</springdoc.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombokbinding.version>0.2.0</lombokbinding.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <!-- QueryDSL: OpenFeign fork (io.github.openfeign.querydsl); the original com.querydsl line is unmaintained since 5.1.0 (2024) -->
        <openfeign-querydsl.version>7.7</openfeign-querydsl.version>
        <!-- JUnit 5 class-level parallelism; override with -Djunit.parallel.enabled=false -->
        <junit.parallel.enabled>true</junit.parallel.enabled>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>volumet.project</groupId>
                <artifactId>volumet-common-utils</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>volumet.project</groupId>
                <artifactId>volumet-common-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>volumet.project</groupId>
                <artifactId>volumet-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>volumet.project</groupId>
                <artifactId>volumet-common-resilience</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.openfeign.querydsl</groupId>
                <artifactId>querydsl-jpa</artifactId>
                <version>${openfeign-querydsl.version}</version>
            </dependency>

            <!-- Q-Class generator -->
            <dependency>
                <groupId>io.github.openfeign.querydsl</groupId>
                <artifactId>querydsl-apt</artifactId>
                <version>${openfeign-querydsl.version}</version>
                <classifier>jakarta</classifier>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombokbinding.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <properties>
                            <!-- Test classes run concurrently; methods within a class stay on one thread. -->
                            <configurationParameters>
                                junit.jupiter.execution.parallel.enabled=${junit.parallel.enabled}
                                junit.jupiter.execution.parallel.mode.default=same_thread
                                junit.jupiter.execution.parallel.mode.classes.default=concurrent
                            </configurationParameters>
                        </properties>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
