# Copy to .env (git-ignored) and fill in the secrets. Used by docker_compose.yml and docker_compose_dev.yml.
# *_WSL2_PORT = port published on the host, *_PORT = port inside the container.

# ---- SQL Server ----
MSSQL_IMAGE_VERSION=2022-latest
DB_PORT=1433
DB_WSL2_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=change-me

# ---- Redis (password lives in redis/redis.conf: requirepass) ----
REDIS_VERSION=7
REDIS_PORT=6379
REDIS_WSL2_PORT=6379

# ---- Keycloak database (PostgreSQL) ----
POSTGRE_KEYCLOAK_DB_VERSION=16
POSTGRE_KEYCLOAK_WSL2_PORT=5432
POSTGRE_KEYCLOAK_DATABASE=keycloak
POSTGRE_KEYCLOAK_USER=keycloak
POSTGRE_KEYCLOAK_PASSWORD=change-me

# ---- Keycloak ----
KEYCLOAK_VERSION=26.0
KEYCLOAK_WSL2_PORT=8088
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# URL keycloak-init uses to reach the Keycloak container (":8080" is appended)
KEYCLOAK_WSL2_BASE_URL=http://keycloak
# Host the backend/browser reaches Keycloak on; pins the token issuer (KC_HOSTNAME)
KEYCLOAK_EXTERNAL_BASE_URL=localhost
KEYCLOAK_CLIENT_SECRET=change-me
# Optional, defaults shown; must match the backend (application.yml)
# KEYCLOAK_REALM=volumet-realm
# KEYCLOAK_CLIENT_ID=volumet-app

# ---- RabbitMQ ----
RABBITMQ_VERSION=4-management
RABBITMQ_PORT=5672
RABBITMQ_WSL2_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_WSL2_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=volumet
RABBITMQ_DEFAULT_PASS=change-me
